<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar because we use a Toolbar widget as ActionBar -->
    <style name="KdeConnectThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Canvas Design brand palette (kept consistent with the Compose theme) -->
        <item name="colorPrimary">@color/canvas_primary</item>
        <item name="colorOnPrimary">@color/canvas_on_primary</item>
        <item name="colorPrimaryContainer">@color/canvas_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/canvas_on_primary_container</item>
        <item name="colorSecondary">@color/canvas_secondary</item>
        <item name="colorOnSecondary">@color/canvas_on_secondary</item>
        <item name="colorSecondaryContainer">@color/canvas_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/canvas_on_secondary_container</item>
        <item name="colorTertiary">@color/canvas_tertiary</item>
        <item name="colorOnTertiary">@color/canvas_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/canvas_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/canvas_on_tertiary_container</item>
        <item name="colorError">@color/canvas_error</item>
        <item name="colorOnError">@color/canvas_on_error</item>
        <item name="colorErrorContainer">@color/canvas_error_container</item>
        <item name="colorOnErrorContainer">@color/canvas_on_error_container</item>
        <item name="android:colorBackground">@color/canvas_background</item>
        <item name="colorOnBackground">@color/canvas_on_background</item>
        <item name="colorSurface">@color/canvas_surface</item>
        <item name="colorOnSurface">@color/canvas_on_surface</item>
        <item name="colorSurfaceVariant">@color/canvas_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/canvas_on_surface_variant</item>
        <item name="colorOutline">@color/canvas_outline</item>
        <item name="colorOutlineVariant">@color/canvas_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/canvas_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/canvas_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/canvas_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/canvas_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/canvas_surface_container_highest</item>

        <!-- Drawable definitions and overrides -->

        <item name="materialCardViewStyle">@style/KdeConnectCardStyle</item>

        <!-- https://github.com/material-components/material-components-android/issues/2732 -->
        <item name="alertDialogTheme">@style/KdeConnectDialogStyle</item>
    </style>

    <style name="KdeConnectTheme" parent="KdeConnectThemeBase" />

    <style name="KdeConnectThemeBase.NoActionBar" parent="KdeConnectTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="KdeConnectTheme.NoActionBar" parent="KdeConnectThemeBase.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="KdeConnectTheme.Toolbar" parent="Widget.AppCompat.Toolbar">
    </style>

    <style name="KdeConnectDialogStyle" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:layout" tools:ignore="PrivateResource">@layout/m3_alert_dialog</item>
        <item name="dialogCornerRadius" tools:ignore="PrivateResource">@dimen/m3_alert_dialog_corner_size</item>
    </style>

    <style name="KdeConnectCardStyle" parent="@style/Widget.Material3.CardView.Outlined">
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/canvas_outline_variant</item>
        <item name="shapeAppearanceOverlay">@style/KdeConnectCardShape</item>
    </style>

    <style name="KdeConnectCardStyle.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardElevation">0dp</item>
        <item name="shapeAppearanceOverlay">@style/KdeConnectCardShape</item>
    </style>

    <style name="KdeConnectCardShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="MainNavigationView">
    </style>

    <style name="KdeConnectButton.IconButton" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="KdeConnectButton.IconButton.Secondary" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="ActionModeStyle" parent="Widget.AppCompat.ActionMode">
    </style>
    <style name="Theme.Transparent" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="AboutButton">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="AboutButton.TextView">
        <item name="android:layout_width">84dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
